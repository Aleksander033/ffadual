{
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "builds": [
    { "src": "**", "use": "@vercel/static" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
